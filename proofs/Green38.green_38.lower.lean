import FormalConjectures.GreensOpenProblems.«38»
/-! Kernel checks for a seven-rectangle partition of the ten-coordinate code of
Itty, Rosin, Carstensen and Reichman (arXiv:2607.21517, Section 3.1).
The five-coordinate input is the Polak–Schrijver code R367.txt, Git blob
ba223a333ffd2f8274a0149a16a6e8b367bcddd1 in nathanielitty/lower-bounds-for-shannon-capacity.
Each word has two checked bit masks for its symbols and their forbidden neighbours. -/

namespace CyclePacking
open Finset Green38
open scoped Pointwise

private def close {n : ℕ} (v w : Fin n → ZMod 7) : Prop :=
  ∀ i, v i - w i ∈ ({-1,0,1} : Finset (ZMod 7))

private theorem close_symm {n : ℕ} {v w : Fin n → ZMod 7} (h : close v w) : close w v := by
  intro i
  have ha := h i
  simp only [mem_insert, mem_singleton] at ha ⊢
  rcases ha with ha|ha|ha
  · right; right; linear_combination -ha
  · right; left; linear_combination -ha
  · left; linear_combination -ha

private theorem close_self {n : ℕ} (w : Fin n → ZMod 7) : close w w := by
  intro i
  simp

private structure Raw where
  code : ℕ
  chosen : ℕ
  far : ℕ

private def word (r : Raw) (i : Fin 5) : ZMod 7 := ((r.code >>> (3*i.val)) % 8 : ℕ)

private def good (r : Raw) : Bool :=
  decide (r.chosen < 2^35) && (List.finRange 35).all fun k =>
    let j : Fin 5 := ⟨k.val/7,by omega⟩
    let z : ZMod 7 := (k.val % 7 : ℕ)
    (!r.chosen.testBit k.val || decide (z=word r j)) &&
    (!r.far.testBit k.val || decide (z-word r j ∉ ({-1,0,1} : Finset (ZMod 7))))

private def apart (p q : Raw) : Bool := (p.chosen &&& q.far) != 0

private theorem incompatible {p q : Raw} (hp : good p = true) (hq : good q = true)
    (h : apart p q = true) : ¬ close (word p) (word q) := by
  intro hc
  have hx : p.chosen &&& q.far = 0 := by
    apply Nat.eq_of_testBit_eq
    intro k
    rw [Nat.testBit_and]
    by_cases h1 : p.chosen.testBit k = true <;> by_cases h2 : q.far.testBit k = true
    · have hlt : k < 35 := by
        by_contra! hk
        have hb : p.chosen < 2^35 := of_decide_eq_true (Bool.and_eq_true_iff.mp hp).1
        have hbound : p.chosen < 2^k := lt_of_lt_of_le hb (Nat.pow_le_pow_right (by decide) hk)
        simp [Nat.testBit_eq_false_of_lt hbound] at h1
      let i : Fin 35 := ⟨k,hlt⟩
      have hmem := List.mem_finRange i
      have hpi := List.all_eq_true.mp (Bool.and_eq_true_iff.mp hp).2 i hmem
      have hqi := List.all_eq_true.mp (Bool.and_eq_true_iff.mp hq).2 i hmem
      have hl := (Bool.and_eq_true_iff.mp hpi).1
      have hr := (Bool.and_eq_true_iff.mp hqi).2
      simp [i,h1,h2] at hl hr
      have hclose := hc ⟨k/7,by omega⟩
      simp only [mem_insert, mem_singleton] at hclose
      rw [← hl] at hclose
      exact False.elim (hclose.elim hr.1 (fun h => h.elim hr.2.1 hr.2.2))
    all_goals simp_all
  simp [apart,hx] at h

private def cross (l r : List Raw) := l.all fun x => r.all (apart x)

private def within : List Raw → Bool
  | [] => true
  | x::xs => xs.all (apart x) && within xs

private theorem within_spec {l : List Raw} (h : within l = true) :
    l.Pairwise (fun x y => apart x y=true) := by
  induction l with
  | nil => exact .nil
  | cons x xs ih =>
    obtain ⟨hf,ht⟩ := Bool.and_eq_true_iff.mp h
    exact List.pairwise_cons.mpr ⟨List.all_eq_true.mp hf,ih ht⟩

private theorem same_index (l : List Raw) (hg : l.all good = true) (hw : within l = true)
    {i j : Fin l.length} (hc : close (word (l.get i)) (word (l.get j))) : i=j := by
  have hi := List.all_eq_true.mp hg _ (List.get_mem l i)
  have hj := List.all_eq_true.mp hg _ (List.get_mem l j)
  have ha := List.pairwise_iff_get.mp (within_spec hw)
  rcases lt_trichotomy i j with h|h|h
  · exact False.elim (incompatible hi hj (ha _ _ h) hc)
  · exact h
  · exact False.elim (incompatible hj hi (ha _ _ h) (close_symm hc))

private theorem across (l r : List Raw) (hl : l.all good = true) (hr : r.all good = true)
    (h : cross l r = true) (i : Fin l.length) (j : Fin r.length) :
    ¬ close (word (l.get i)) (word (r.get j)) := by
  have hi := List.get_mem l i
  have hj := List.get_mem r j
  exact incompatible (List.all_eq_true.mp hl _ hi) (List.all_eq_true.mp hr _ hj)
    (List.all_eq_true.mp (List.all_eq_true.mp h _ hi) _ hj)

private abbrev Block := List Raw × List Raw
private def validBlock (b : Block) :=
  (b.1.all good && within b.1) && (b.2.all good && within b.2)
private def distinctBlocks (b c : Block) :=
  cross b.1 c.1 || cross b.2 c.2
private def outside : List Block → Bool
  | [] => true
  | b::bs => bs.all (distinctBlocks b) && outside bs

private theorem outside_spec {L : List Block} (hh : outside L = true) :
    L.Pairwise (fun b c => distinctBlocks b c = true) := by
  induction L with
  | nil => exact .nil
  | cons b bs ih =>
    obtain ⟨hf,ht⟩ := Bool.and_eq_true_iff.mp hh
    exact List.pairwise_cons.mpr ⟨List.all_eq_true.mp hf,ih ht⟩

private abbrev Index (L : List Block) :=
  (i : Fin L.length) × (Fin (L.get i).1.length × Fin (L.get i).2.length)

private def blockWord (L : List Block) (x : Index L) : Fin 10 → ZMod 7 :=
  Fin.append (word ((L.get x.1).1.get x.2.1)) (word ((L.get x.1).2.get x.2.2))

private theorem split_close {v w x y : Fin 5 → ZMod 7}
    (hc : close (Fin.append v w) (Fin.append x y)) : close v x ∧ close w y := by
  constructor
  · intro i; simpa only [Fin.append_left] using hc (Fin.castAdd 5 i)
  · intro i; simpa only [Fin.append_right] using hc (Fin.natAdd 5 i)

private theorem block_sep (L : List Block) (hv : L.all validBlock = true) (hd : outside L = true)
    (x y : Index L) (hc : close (blockWord L x) (blockWord L y)) : x=y := by
  obtain ⟨i,u,v⟩ := x
  obtain ⟨j,z,w⟩ := y
  have hh i := Bool.and_eq_true_iff.mp (List.all_eq_true.mp hv _ (List.get_mem L i))
  have diff (i j : Fin L.length) (hij : i < j)
      (u : Fin (L.get i).1.length) (v : Fin (L.get i).2.length)
      (z : Fin (L.get j).1.length) (w : Fin (L.get j).2.length)
      (h : close (blockWord L ⟨i,u,v⟩) (blockWord L ⟨j,z,w⟩)) : False := by
    have hs := split_close h
    have hp := List.pairwise_iff_get.mp (outside_spec hd) i j hij
    rcases Bool.or_eq_true_iff.mp hp with h|h
    · exact across _ _ (Bool.and_eq_true_iff.mp (hh i).1).1
        (Bool.and_eq_true_iff.mp (hh j).1).1 h u z hs.1
    · exact across _ _ (Bool.and_eq_true_iff.mp (hh i).2).1
        (Bool.and_eq_true_iff.mp (hh j).2).1 h v w hs.2
  rcases lt_trichotomy i j with hij|rfl|hji
  · exact False.elim (diff i j hij u v z w hc)
  · have hs := split_close hc
    obtain ⟨h1,h2⟩ := hh i
    have := same_index _ (Bool.and_eq_true_iff.mp h1).1 (Bool.and_eq_true_iff.mp h1).2 hs.1
    have := same_index _ (Bool.and_eq_true_iff.mp h2).1 (Bool.and_eq_true_iff.mp h2).2 hs.2
    congr 2
  · exact False.elim (diff j i hji z w u v (close_symm hc))
