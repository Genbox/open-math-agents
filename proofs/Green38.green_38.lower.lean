private def repeatWord {T : Type} (v : T → Fin 10 → ZMod 7) (n : ℕ)
    (f : Fin (n/10) → T) (i : Fin n) : ZMod 7 :=
  if hi : i.val / 10 < n/10 then v (f ⟨i.val/10,hi⟩) ⟨i.val%10,by omega⟩ else 0

private theorem repeat_at {T : Type} (v : T → Fin 10 → ZMod 7) (n : ℕ)
    (f : Fin (n/10) → T) (k : Fin (n/10)) (j : Fin 10) :
    repeatWord v n f ⟨10*k.val+j.val,by omega⟩ = v (f k) j := by
  unfold repeatWord
  have hdiv : (10*k.val+j.val)/10=k.val := by omega
  have hmod : (10*k.val+j.val)%10=j.val := by omega
  simp [hdiv,hmod]

private theorem amplify {T : Type} [Fintype T] (v : T → Fin 10 → ZMod 7)
    (sep : ∀ x y, close (v x) (v y) → x=y) (n : ℕ) :
    (Fintype.card T : ℝ)^(n/10) ≤ LargestAdmissibleCardinality n := by
  classical
  have hsep (f g : Fin (n/10) → T) (hh : close (repeatWord v n f) (repeatWord v n g)) : f=g := by
    funext k
    apply sep
    intro j
    simpa only [repeat_at] using hh ⟨10*k.val+j.val,by omega⟩
  let emb : (Fin (n/10) → T) ↪ (Fin n → ZMod 7) :=
    ⟨repeatWord v n, fun f g h => hsep f g (h ▸ close_self _)⟩
  let A := univ.map emb
  have ha : IntersectsOnlyAtZero A := by
    intro a ha hd
    obtain ⟨p,hp,q,hq,rfl⟩ := Finset.mem_sub.mp ha
    obtain ⟨f,_,rfl⟩ := Finset.mem_map.mp hp
    obtain ⟨g,_,rfl⟩ := Finset.mem_map.mp hq
    have he := hsep f g hd
    subst g
    exact sub_self _
  have hle : A.card ≤ sSup (ValidCardinalities n) :=
    le_csSup (green_38.test_bound_above) ⟨A,ha,rfl⟩
  have heq : A.card = (Fintype.card T)^(n/10) := by simp [A]
  rw [heq] at hle
  change _ ≤ ((sSup (ValidCardinalities n) : ℕ) : ℝ)
  exact_mod_cast hle


private theorem lower_all (n : ℕ) : (134753 : ℝ)^(n / 10) ≤ LargestAdmissibleCardinality n := by
  have h := amplify (blockWord blocks) (block_sep blocks check_blocks check_cross) n
  rwa [count_blocks] at h

private theorem improve (hb : ∀ n : ℕ, (134753:ℝ)^(n/10) ≤ LargestAdmissibleCardinality n) :
    type_of% @Green38.green_38.lower := by
  let c := (134753:ℝ)^((1:ℝ)/10)
  have h1 : 1 ≤ c := Real.one_le_rpow (by norm_num) (by norm_num)
  have h10 : c^10 = (134753:ℝ) := by
    dsimp [c]
    rw [← Real.rpow_natCast _ 10, ← Real.rpow_mul (by norm_num)]
    norm_num
  have hbig : C₁ < c := by
    have hs : C₁ ^10 = (134689:ℝ) := by
      rw [C₁, ← Real.rpow_natCast _ 10, ← Real.rpow_mul (by norm_num)]
      norm_num
    by_contra! hh
    have hle := pow_le_pow_left₀ (zero_le_one.trans h1) hh 10
    linarith
  refine ⟨Filter.Eventually.of_forall (fun n => by dsimp [green_38.lower.answer]; positivity),
    Filter.Eventually.of_forall hb,c,hbig,?_⟩
  apply Asymptotics.isBigO_iff.mpr
  refine ⟨134753, Filter.Eventually.of_forall (fun n => ?_)⟩
  dsimp only [green_38.lower.answer]
  rw [Real.norm_of_nonneg (pow_nonneg (zero_le_one.trans h1) _),
    Real.norm_of_nonneg (pow_nonneg (by norm_num) _)]
  calc
    c^n = c^(n%10) * (c^10)^(n/10) := by rw [← pow_mul, ← pow_add, Nat.mod_add_div]
    _ ≤ _ := by
      rw [h10]
      gcongr
      exact (pow_le_pow_right₀ h1 (show n%10 ≤ 10 by omega)).trans_eq h10

end CyclePacking

theorem OMA.solution : type_of% @Green38.green_38.lower := CyclePacking.improve CyclePacking.lower_all