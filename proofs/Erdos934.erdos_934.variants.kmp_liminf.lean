private def info (u : Vertex) : OctadData :=
  (allOctads[u.val / 23]!)[u.val % 23]!

private def twistPoint (i : Point) : Point :=
  (#[0, 9, 3, 13, 1, 19, 12, 10, 8, 6, 14, 15, 4, 16, 11, 7, 18, 22, 2, 21, 20, 17, 5] : Array Point)[i.val]!

private def movePoint (t : Bool) (i : Point) : Point :=
  if t then twistPoint i else i + 1

private def move (t : Bool) (u : Vertex) : Vertex :=
  ⟨(if t then (info u).twist else (info u).rotate) % 506, Nat.mod_lt _ (by decide)⟩

private def retreat (t : Bool) (u : Vertex) : Vertex :=
  ⟨(if t then (info u).untwist else (info u).unrotate) % 506, Nat.mod_lt _ (by decide)⟩

private def parent (u : Vertex) : Vertex :=
  ⟨(info u).parent % 506, Nat.mod_lt _ (by decide)⟩

private def withZero (u : Vertex) : Vertex :=
  ⟨(info u).commonWithZero % 506, Nat.mod_lt _ (by decide)⟩


private def pointBit (m n : Nat) : Bool := m / 2 ^ n % 2 == 1

private def points (u : Vertex) : Finset Point :=
  Finset.univ.filter (fun i => pointBit (info u).mask i.val = true)

private def moveBitsStatement : Prop :=
  ∀ (u : Vertex) (t : Bool) (i : Point),
    pointBit (info u).mask i.val = pointBit (info (move t u)).mask (movePoint t i).val

private def moveStepStatement : Prop :=
  ∀ u : Vertex,
    (u = 0 ∨ (parent u).val < u.val ∧ move (info u).useTwist (parent u) = u) ∧
      ∀ t, move t (retreat t u) = u

private def intersections (u v : Vertex) : ℕ := (points u ∩ points v).card

private def baseStatement : Prop :=
  (points 0).card = 8 ∧
    (Finset.univ.filter (fun v : Vertex => intersections 0 v = 0)).card = 15 ∧
    ∀ v : Vertex,
      (v = 0 ∨ intersections 0 v = 0 ∨ intersections 0 v = 2 ∨ intersections 0 v = 4) ∧
      (intersections 0 v = 4 → intersections 0 (withZero v) = 0 ∧
        intersections v (withZero v) = 0)

set_option maxRecDepth 10000 in
private theorem movePoint_injective : ∀ (t : Bool) (i j : Point),
    movePoint t i = movePoint t j → i = j := by decide +kernel

private noncomputable def pointEquiv (t : Bool) : Equiv.Perm Point :=
  Equiv.ofBijective (movePoint t)
    (Finite.injective_iff_bijective.mp (movePoint_injective t))

private lemma points_move (hBits : moveBitsStatement) (t : Bool) (u : Vertex) :
    (points u).map (pointEquiv t).toEmbedding = points (move t u) := by
  ext y
  obtain ⟨k,rfl⟩ := (pointEquiv t).surjective y
  rw [Finset.mem_map_equiv,Equiv.symm_apply_apply]
  simp only [points,Finset.mem_filter,Finset.mem_univ,true_and]
  change pointBit (info u).mask k.val = true ↔
    pointBit (info (move t u)).mask (movePoint t k).val = true
  rw [hBits u t k]

private lemma intersections_move (hBits : moveBitsStatement) (t : Bool) (u v : Vertex) :
    intersections (move t u) (move t v) = intersections u v := by
  unfold intersections
  rw [← points_move hBits t u,← points_move hBits t v,← Finset.map_inter,Finset.card_map]

private lemma move_surjective (hStep : moveStepStatement) (t : Bool) :
    Function.Surjective (move t) :=
  fun u => ⟨retreat t u,(hStep u).2 t⟩

private lemma traverse (hStep : moveStepStatement) {P : Vertex → Prop}
    (hZero : P 0) (hMove : ∀ t u, P u → P (move t u)) (u : Vertex) : P u := by
  induction h : u.val using Nat.strong_induction_on generalizing u with
  | _ n ih =>
    rcases (hStep u).1 with rfl | ⟨hlt,hp⟩
    · exact hZero
    · rw [← hp]
      apply hMove
      exact ih (parent u).val (h ▸ hlt) (parent u) rfl

private lemma points_card (hBits : moveBitsStatement) (hStep : moveStepStatement)
    (hBase : baseStatement) (u : Vertex) : (points u).card = 8 := by
  apply traverse hStep hBase.1 _ u
  intro t v hv
  rw [← points_move hBits t v,Finset.card_map,hv]

private def makeGraph (hBits : moveBitsStatement) (hStep : moveStepStatement)
    (hBase : baseStatement) : SimpleGraph Vertex where
  Adj u v := intersections u v = 0
  symm := by
    constructor
    intro u v h
    simpa [intersections,Finset.inter_comm] using h
  loopless := by
    constructor
    intro u h
    change intersections u u = 0 at h
    simp [intersections,points_card hBits hStep hBase] at h

private instance graphAdjDecision (hBits : moveBitsStatement) (hStep : moveStepStatement)
    (hBase : baseStatement) : DecidableRel (makeGraph hBits hStep hBase).Adj :=
  fun u v => inferInstanceAs (Decidable (intersections u v = 0))

private lemma graph_degree (hBits : moveBitsStatement) (hStep : moveStepStatement)
    (hBase : baseStatement) (u : Vertex) : (makeGraph hBits hStep hBase).degree u = 15 := by
  let G := makeGraph hBits hStep hBase
  have graph_adj (a b : Vertex) : G.Adj a b ↔ intersections a b = 0 := Iff.rfl
  have baseDeg : G.degree 0 = 15 := by
    rw [← SimpleGraph.card_neighborFinset_eq_degree, G.neighborFinset_eq_filter]
    exact hBase.2.1
  change G.degree u = 15
  apply traverse hStep baseDeg _ u
  intro t v hv
  have hs := move_surjective hStep t
  have hi := Finite.injective_iff_surjective.mpr hs
  have hcard : (G.neighborFinset v).card = (G.neighborFinset (move t v)).card := by
    apply Finset.card_bij (fun a _ => move t a)
    · intro a ha
      rw [SimpleGraph.mem_neighborFinset, graph_adj, intersections_move hBits]
      exact (graph_adj v a).mp ((G.mem_neighborFinset v a).mp ha)
    · intro a _ b _ h
      exact hi h
    · intro b hb
      obtain ⟨a,rfl⟩ := hs b
      refine ⟨a,?_,rfl⟩
      rw [SimpleGraph.mem_neighborFinset,graph_adj] at hb ⊢
      rwa [intersections_move hBits] at hb
  rw [SimpleGraph.card_neighborFinset_eq_degree,SimpleGraph.card_neighborFinset_eq_degree] at hcard
  exact hcard.symm.trans hv

private lemma pair_properties (hBits : moveBitsStatement) (hStep : moveStepStatement)
    (hBase : baseStatement) (u v : Vertex) :
    (u = v ∨ intersections u v = 0 ∨ intersections u v = 2 ∨ intersections u v = 4) ∧
    (intersections u v = 4 → ∃ c, intersections u c = 0 ∧ intersections v c = 0) := by
  revert v
  refine traverse hStep (P := fun a => ∀ b : Vertex,
    (a = b ∨ intersections a b = 0 ∨ intersections a b = 2 ∨ intersections a b = 4) ∧
    (intersections a b = 4 → ∃ c, intersections a c = 0 ∧ intersections b c = 0)) ?_ ?_ u
  · intro v
    obtain ⟨hCases,hFour⟩ := hBase.2.2 v
    refine ⟨?_,fun hv => ⟨withZero v,hFour hv⟩⟩
    rcases hCases with e | h
    · exact Or.inl e.symm
    · exact Or.inr h
  · intro t u h v
    obtain ⟨v,rfl⟩ := move_surjective hStep t v
    obtain ⟨hc,hw⟩ := h v
    simp only [intersections_move hBits]
    refine ⟨?_,?_⟩
    · rcases hc with rfl | hc
      · exact Or.inl rfl
      · exact Or.inr hc
    · intro hv
      obtain ⟨c,huc,hvc⟩ := hw hv
      refine ⟨move t c, ?_, ?_⟩
      · rw [intersections_move hBits,huc]
      · rw [intersections_move hBits,hvc]

private theorem graph_common (hBits : moveBitsStatement) (hStep : moveStepStatement)
    (hBase : baseStatement) (u v w x : Vertex)
    (huv : (makeGraph hBits hStep hBase).Adj u v)
    (hwx : (makeGraph hBits hStep hBase).Adj w x) :
    ∃ a ∈ ({u,v} : Set Vertex), ∃ b ∈ ({w,x} : Set Vertex),
      ∃ c, (makeGraph hBits hStep hBase).Adj a c ∧ (makeGraph hBits hStep hBase).Adj b c := by
  let G := makeGraph hBits hStep hBase
  by_contra! hn
  have hSmall (a b : Vertex) (ha : a ∈ ({u,v} : Set Vertex))
      (hb : b ∈ ({w,x} : Set Vertex)) : intersections a b ≤ 2 := by
    obtain ⟨hCases,hFour⟩ := pair_properties hBits hStep hBase a b
    rcases hCases with rfl | h0 | h2 | h4
    · have hp : 0 < G.degree a := by rw [graph_degree hBits hStep hBase]; decide
      obtain ⟨c,hc⟩ := (G.degree_pos_iff_exists_adj a).mp hp
      exact (hn a ha a hb c hc hc).elim
    · omega
    · omega
    · obtain ⟨c,hac,hbc⟩ := hFour h4
      exact (hn a ha b hb c hac hbc).elim
  have huv' : (points u ∩ points v).card = 0 := huv
  have hwx' : (points w ∩ points x).card = 0 := hwx
  let U := points u ∪ points v
  let W := points w ∪ points x
  have hU : U.card = 16 := by
    have h := Finset.card_union_add_card_inter (points u) (points v)
    rw [huv',points_card hBits hStep hBase,points_card hBits hStep hBase] at h
    exact h
  have hW : W.card = 16 := by
    have h := Finset.card_union_add_card_inter (points w) (points x)
    rw [hwx',points_card hBits hStep hBase,points_card hBits hStep hBase] at h
    exact h
  have hDetect := Finset.card_union_add_card_inter U W
  have hMax : (U ∪ W).card ≤ 23 := by
    exact (Finset.card_le_univ _).trans (by simp)
  have hLower : 9 ≤ (U ∩ W).card := by omega
  have hEq : U ∩ W = ((points u ∩ points w) ∪ (points u ∩ points x)) ∪
      ((points v ∩ points w) ∪ (points v ∩ points x)) := by
    ext i
    simp only [U,W,Finset.mem_inter,Finset.mem_union]
    tauto
  have huw := hSmall u w (by simp) (by simp)
  have hux := hSmall u x (by simp) (by simp)
  have hvw := hSmall v w (by simp) (by simp)
  have hvx := hSmall v x (by simp) (by simp)
  rw [hEq] at hLower
  have hFirst := Finset.card_union_le (points u ∩ points w) (points u ∩ points x)
  have hSecond := Finset.card_union_le (points v ∩ points w) (points v ∩ points x)
  have hTotal := Finset.card_union_le ((points u ∩ points w) ∪ (points u ∩ points x))
    ((points v ∩ points w) ∪ (points v ∩ points x))
  unfold intersections at huw hux hvw hvx
  omega


private def chunkIndex (c : Fin 22) (i : Fin 23) : Vertex :=
  ⟨23 * c.val + i.val, by omega⟩

private lemma chunkIndex_cover (u : Vertex) :
    chunkIndex ⟨u.val / 23, by omega⟩ ⟨u.val % 23, by omega⟩ = u :=
  Fin.ext (Nat.div_add_mod u.val 23)

private def checkMove (u : Vertex) (t : Bool) : Bool :=
  let source := (info u).mask
  let target := (info (move t u)).mask
  (List.finRange 23).all (fun k => pointBit source k.val == pointBit target (movePoint t k).val)

private def checkChunk (c : Fin 22) : Bool :=
  (List.finRange 23).all (fun i => checkMove (chunkIndex c i) false && checkMove (chunkIndex c i) true)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
private theorem checkedChunks (c : Fin 22) : checkChunk c = true := by
  fin_cases c <;> decide +kernel

private theorem checkedBits : moveBitsStatement := by
  intro u t i
  classical
  let c : Fin 22 := ⟨u.val / 23, by omega⟩
  let d : Fin 23 := ⟨u.val % 23, by omega⟩
  have hcover : chunkIndex c d = u := chunkIndex_cover u
  have h := List.all_eq_true.mp (checkedChunks c) d (by simp)
  rw [hcover] at h
  obtain ⟨hFalse,hTrue⟩ := Bool.and_eq_true_iff.mp h
  have hv : checkMove u t = true := by cases t <;> assumption
  have hi := List.all_eq_true.mp hv i (by simp)
  exact beq_iff_eq.mp hi

private def zeroNeighbors : Finset Vertex :=
  {33, 62, 82, 124, 147, 203, 283, 296, 306, 363, 440, 442, 466, 490, 503}

private abbrev verifyStep (u : Vertex) : Prop :=
  (u = 0 ∨ (parent u).val < u.val ∧ move (info u).useTwist (parent u) = u) ∧
    ∀ t, move t (retreat t u) = u

private abbrev verifyRow (v : Vertex) : Prop :=
  (v = 0 ∨ intersections 0 v = 0 ∨ intersections 0 v = 2 ∨ intersections 0 v = 4) ∧
    (intersections 0 v = 4 → intersections 0 (withZero v) = 0 ∧
      intersections v (withZero v) = 0) ∧
    (v ∈ zeroNeighbors ↔ intersections 0 v = 0)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
private theorem checkedRows (c : Fin 22) :
    ∀ i : Fin 23, verifyStep (chunkIndex c i) ∧ verifyRow (chunkIndex c i) := by
  fin_cases c <;> decide +kernel

private lemma checkedRow (u : Vertex) : verifyStep u ∧ verifyRow u := by
  let c : Fin 22 := ⟨u.val / 23, by omega⟩
  let i : Fin 23 := ⟨u.val % 23, by omega⟩
  have h := checkedRows c i
  rwa [chunkIndex_cover u] at h

private theorem checkedStep : moveStepStatement := fun u => (checkedRow u).1

private theorem checkedBase : baseStatement := by
  refine ⟨by decide +kernel,?_,fun v => ⟨(checkedRow v).2.1,(checkedRow v).2.2.1⟩⟩
  have h : Finset.univ.filter (fun v : Vertex => intersections 0 v = 0) = zeroNeighbors := by
    ext v
    simpa only [Finset.mem_filter,Finset.mem_univ,true_and] using (checkedRow v).2.2.2.symm
  rw [h]
  decide +kernel

/-- The graph on the 506 weight-eight words with disjointness adjacency. -/
def graph : SimpleGraph (Fin 506) := makeGraph checkedBits checkedStep checkedBase

instance : DecidableRel graph.Adj := graphAdjDecision checkedBits checkedStep checkedBase

theorem degree (u : Fin 506) : graph.degree u = 15 :=
  graph_degree checkedBits checkedStep checkedBase u

theorem common (u v w x : Fin 506) (huv : graph.Adj u v) (hwx : graph.Adj w x) :
    ∃ a ∈ ({u,v} : Set (Fin 506)), ∃ b ∈ ({w,x} : Set (Fin 506)),
      ∃ c, graph.Adj a c ∧ graph.Adj b c :=
  graph_common checkedBits checkedStep checkedBase u v w x huv hwx

end KMPBase

namespace KMPProduct

variable {V X Y : Type*}

def CommonEndpoints (G : SimpleGraph V) : Prop :=
  ∀ u v w x, G.Adj u v → G.Adj w x →
    ∃ a ∈ ({u, v} : Set V), ∃ b ∈ ({w, x} : Set V), ∃ c, G.Adj a c ∧ G.Adj b c

lemma noFar {G : SimpleGraph V} (h : CommonEndpoints G) : ¬ Erdos934.HasFarEdges G 3 := by
  rintro ⟨u, v, w, x, huv, hwx, hfar⟩
  obtain ⟨a, ha, b, hb, c, hac, hbc⟩ := h u v w x huv hwx
  have hp := (Walk.cons hac (Walk.cons hbc.symm Walk.nil)).edist_le
  have hab : G.edist a b ≤ (2 : ℕ∞) := by simpa using hp
  exact (show ¬ (3 : ℕ∞) ≤ 2 by decide) ((hfar a ha b hb).trans hab)

def lift (G : SimpleGraph V) (R : X → X → Prop) (hs : (∀ ⦃a b⦄, R a b → R b a)) :
    SimpleGraph (V × X) where
  Adj u v := G.Adj u.1 v.1 ∧ R u.2 v.2
  symm := ⟨fun _ _ h => ⟨h.1.symm, hs h.2⟩⟩
  loopless := ⟨fun _ h => G.irrefl h.1⟩

instance (G : SimpleGraph V) (R : X → X → Prop) (hs : (∀ ⦃a b⦄, R a b → R b a))
    [DecidableRel G.Adj] [DecidableRel R] : DecidableRel (lift G R hs).Adj :=
  fun u v => inferInstanceAs (Decidable (G.Adj u.1 v.1 ∧ R u.2 v.2))

lemma lift_degree [Fintype V] [Fintype X] (G : SimpleGraph V) (R : X → X → Prop)
    (hs : (∀ ⦃a b⦄, R a b → R b a)) [DecidableRel G.Adj] [DecidableRel R] (u : V × X) :
    (lift G R hs).degree u = G.degree u.1 * (univ.filter (R u.2)).card := by
  have hcard : (lift G R hs).neighborFinset u =
      (G.neighborFinset u.1) ×ˢ (univ.filter (R u.2)) := by
    ext v
    rw [SimpleGraph.mem_neighborFinset]
    change (G.Adj u.1 v.1 ∧ R u.2 v.2) ↔ _
    simp
  rw [← card_neighborFinset_eq_degree, hcard, card_product, card_neighborFinset_eq_degree]

lemma lift_common {G : SimpleGraph V} {R : X → X → Prop} (hs : (∀ ⦃a b⦄, R a b → R b a))
    (hG : CommonEndpoints G) (hR : ∀ x y, ∃ z, R x z ∧ R y z) :
    CommonEndpoints (lift G R hs) := by
  intro u v w x huv hwx
  obtain ⟨a, ha, b, hb, c, hca, hcb⟩ := hG u.1 v.1 w.1 x.1 huv.1 hwx.1
  have hlift (p q : V × X) (i : V) (hi : i ∈ ({p.1, q.1} : Set V)) :
      ∃ t ∈ ({p, q} : Set (V × X)), t.1 = i := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hi
    rcases hi with rfl | rfl
    · exact ⟨p, by simp, rfl⟩
    · exact ⟨q, by simp, rfl⟩
  obtain ⟨a', ha', rfl⟩ := hlift u v a ha
  obtain ⟨b', hb', rfl⟩ := hlift w x b hb
  obtain ⟨z, haz, hbz⟩ := hR a'.2 b'.2
  exact ⟨a', ha', b', hb', (c, z), ⟨hca, haz⟩, ⟨hcb, hbz⟩⟩

def prodRel (R : X → X → Prop) (T : Y → Y → Prop) (x y : X × Y) : Prop :=
  R x.1 y.1 ∧ T x.2 y.2

instance (R : X → X → Prop) (T : Y → Y → Prop) [DecidableRel R] [DecidableRel T] :
    DecidableRel (prodRel R T) :=
  fun x y => inferInstanceAs (Decidable (R x.1 y.1 ∧ T x.2 y.2))

lemma prod_symm {R : X → X → Prop} {T : Y → Y → Prop} (hR : (∀ ⦃a b⦄, R a b → R b a))
    (hT : (∀ ⦃a b⦄, T a b → T b a)) : ∀ ⦃a b⦄, prodRel R T a b → prodRel R T b a :=
  fun _ _ h => ⟨hR h.1, hT h.2⟩

lemma prod_common {R : X → X → Prop} {T : Y → Y → Prop}
    (hR : ∀ x y, ∃ z, R x z ∧ R y z) (hT : ∀ x y, ∃ z, T x z ∧ T y z)
    (x y : X × Y) : ∃ z, prodRel R T x z ∧ prodRel R T y z := by
  obtain ⟨a, hxa, hya⟩ := hR x.1 y.1
  obtain ⟨b, hxb, hyb⟩ := hT x.2 y.2
  exact ⟨(a, b), ⟨hxa, hxb⟩, ⟨hya, hyb⟩⟩

lemma prod_card [Fintype X] [Fintype Y] (R : X → X → Prop) (T : Y → Y → Prop)
    [DecidableRel R] [DecidableRel T] (x : X × Y) :
    (univ.filter (prodRel R T x)).card =
      (univ.filter (R x.1)).card * (univ.filter (T x.2)).card := by
  have hh : univ.filter (prodRel R T x) =
      (univ.filter (R x.1)) ×ˢ (univ.filter (T x.2)) := by
    ext y
    simp [prodRel]
  rw [hh, card_product]

lemma edge_count [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj] {r : ℕ}
    (hreg : ∀ v, G.degree v = r) :
    2 * G.edgeFinset.card = Fintype.card V * r := by
  classical
  rw [← G.sum_degrees_eq_twice_card_edges]
  simp [hreg]

lemma comap_common {G : SimpleGraph V} (h : CommonEndpoints G) (f : X ≃ V) :
    CommonEndpoints (G.comap f) := by
  intro u v w x huv hwx
  obtain ⟨a, ha, b, hb, c, hac, hbc⟩ := h (f u) (f v) (f w) (f x) huv hwx
  refine ⟨f.symm a, ?_, f.symm b, ?_, f.symm c, ?_, ?_⟩
  · simpa only [Set.mem_insert_iff, Set.mem_singleton_iff, Equiv.symm_apply_eq] using ha
  · simpa only [Set.mem_insert_iff, Set.mem_singleton_iff, Equiv.symm_apply_eq] using hb
  · simpa only [comap_adj, Equiv.apply_symm_apply] using hac
  · simpa only [comap_adj, Equiv.apply_symm_apply] using hbc

end KMPProduct

namespace KMPThreshold

variable {V : Type*} [Fintype V]
variable (G : SimpleGraph V) [DecidableRel G.Adj]

private def expand [DecidableEq V] (S : Finset V) : Finset V :=
  S ∪ S.biUnion (fun v => G.neighborFinset v)

private lemma mem_expand [DecidableEq V] {S : Finset V} {v : V} (hv : v ∈ S) :
    v ∈ expand G S :=
  Finset.mem_union_left _ hv

private lemma adj_expand [DecidableEq V] {S : Finset V} {u v : V} (hu : u ∈ S)
    (huv : G.Adj u v) : v ∈ expand G S :=
  Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨u, hu, (G.mem_neighborFinset _ _).mpr huv⟩)

private lemma expand_card [DecidableEq V] {d : ℕ} (hd : ∀ v, G.degree v ≤ d) (S : Finset V) :
    (expand G S).card ≤ S.card * (d + 1) := by
  have hs : (S.biUnion (fun v => G.neighborFinset v)).card ≤ S.card * d := by
    calc
      _ ≤ ∑ x ∈ S, (G.neighborFinset x).card := Finset.card_biUnion_le
      _ ≤ ∑ _ ∈ S, d := Finset.sum_le_sum fun x _ => by
        simpa only [G.card_neighborFinset_eq_degree] using hd x
      _ = _ := by simp
  unfold expand
  rw [Nat.mul_succ]
  exact (Finset.card_union_le _ _).trans (by omega)

private lemma close_mem [DecidableEq V] {S : Finset V} {r z : V}
    (hr : r ∈ S) (hz : G.edist r z < 3) : z ∈ expand G (expand G S) := by
  have hreach : G.Reachable r z := reachable_of_edist_ne_top (hz.trans_le le_top).ne
  obtain ⟨p, hp⟩ := hreach.exists_walk_length_eq_edist
  have hlen : p.length < 3 := by
    have hcast : (p.length : ℕ∞) < ((3 : ℕ) : ℕ∞) := hp.trans_lt hz
    exact ENat.natCast_lt_natCast.mp hcast
  cases p with
  | nil => exact mem_expand G (mem_expand G hr)
  | @cons r y z hry p =>
    have hy := adj_expand G hr hry
    cases p with
    | nil => exact mem_expand G hy
    | @cons y w z hyw p =>
      have hp0 : p.length = 0 := by
        simp only [Walk.length_cons] at hlen
        omega
      have he := p.eq_of_length_eq_zero hp0
      subst z
      exact adj_expand G hy hyw

omit [Fintype V] [DecidableRel G.Adj] in
private lemma near {u v x y : V} (h : ¬ Erdos934.HasFarEdges G 3)
    (huv : G.Adj u v) (hxy : G.Adj x y) :
    G.edist u x < 3 ∨ G.edist u y < 3 ∨ G.edist v x < 3 ∨ G.edist v y < 3 := by
  by_contra! hn
  apply h
  refine ⟨u, v, x, y, huv, hxy, ?_⟩
  intro a ha b hb
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
  rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
  · exact hn.1
  · exact hn.2.1
  · exact hn.2.2.1
  · exact hn.2.2.2

private lemma edge_bound {d : ℕ} (hd : ∀ v, G.degree v ≤ d)
    (h : ¬ Erdos934.HasFarEdges G 3) :
    G.edgeFinset.card ≤ 2 * (d + 1) ^ 2 * d := by
  classical
  by_cases he : G.edgeFinset.Nonempty
  · obtain ⟨e, he⟩ := he
    induction e using Sym2.inductionOn with
    | _ u v =>
      have huv : G.Adj u v := SimpleGraph.mem_edgeFinset.mp he
      let S : Finset V := {u, v}
      let B := expand G (expand G S)
      let incident (x : V) := (G.neighborFinset x).image (fun y => s(x, y))
      have hcover {x y : V} (hx : x ∈ B) (hxy : G.Adj x y) :
          s(x, y) ∈ B.biUnion incident :=
        Finset.mem_biUnion.mpr ⟨x, hx, Finset.mem_image_of_mem _ ((G.mem_neighborFinset _ _).mpr hxy)⟩
      have hsub : G.edgeFinset ⊆ B.biUnion incident := by
        intro f hf
        induction f using Sym2.inductionOn with
        | _ x y =>
          have hxy : G.Adj x y := SimpleGraph.mem_edgeFinset.mp hf
          rcases near G h huv hxy with hux | huy | hvx | hvy
          · exact hcover (close_mem G (by simp [S] : u ∈ S) hux) hxy
          · exact Sym2.eq_swap ▸ hcover (close_mem G (by simp [S] : u ∈ S) huy) hxy.symm
          · exact hcover (close_mem G (by simp [S] : v ∈ S) hvx) hxy
          · exact Sym2.eq_swap ▸ hcover (close_mem G (by simp [S] : v ∈ S) hvy) hxy.symm
      have hS : S.card = 2 := by simp [S, huv.ne]
      have hB : B.card ≤ 2 * (d + 1) ^ 2 := by
        calc
          B.card ≤ (expand G S).card * (d + 1) := expand_card G hd _
          _ ≤ (S.card * (d + 1)) * (d + 1) :=
            Nat.mul_le_mul_right _ (expand_card G hd S)
          _ = _ := by rw [hS]; ring
      calc
        _ ≤ (B.biUnion incident).card := Finset.card_le_card hsub
        _ ≤ ∑ x ∈ B, (incident x).card := Finset.card_biUnion_le
        _ ≤ ∑ _ ∈ B, d := Finset.sum_le_sum fun x _ => Finset.card_image_le.trans
          ((G.card_neighborFinset_eq_degree x).trans_le (hd x))
        _ = B.card * d := by simp
        _ ≤ _ := Nat.mul_le_mul_right _ hB
  · rw [Finset.not_nonempty_iff_eq_empty.mp he]
    simp

lemma threshold_exists (d : ℕ) : Set.Nonempty {m : ℕ | ∀ (n : ℕ) (H : SimpleGraph (Fin n)),
    (∀ v, (H.neighborSet v).ncard ≤ d) → m ≤ H.edgeSet.ncard → Erdos934.HasFarEdges H 3} := by
  refine ⟨2 * (d + 1) ^ 2 * d + 1, ?_⟩
  intro n H hd he
  classical
  by_contra hn
  have hdeg (v : Fin n) : H.degree v ≤ d := by
    simpa only [← H.coe_neighborFinset, Set.ncard_coe_finset, H.card_neighborFinset_eq_degree]
      using hd v
  have hc : H.edgeFinset.card = H.edgeSet.ncard := by
    rw [← Set.ncard_coe_finset, SimpleGraph.coe_edgeFinset]
  have hm := edge_bound H hdeg hn
  rw [hc] at hm
  omega

lemma le_h {d : ℕ} (hd : ∀ v, G.degree v ≤ d) (h : KMPProduct.CommonEndpoints G) :
    G.edgeFinset.card ≤ Erdos934.h 3 d := by
  classical
  let f := (Fintype.equivFin V).symm
  let H := G.comap f
  let i : H ≃g G := SimpleGraph.Iso.comap f G
  have hD (x : Fin (Fintype.card V)) : (H.neighborSet x).ncard ≤ d := by
    rw [← H.coe_neighborFinset, Set.ncard_coe_finset, H.card_neighborFinset_eq_degree, ← i.degree_eq]
    exact hd (i x)
  have hE : H.edgeSet.ncard = G.edgeFinset.card := by
    rw [← SimpleGraph.coe_edgeFinset, Set.ncard_coe_finset, i.card_edgeFinset_eq]
  have hh := Nat.sInf_mem (threshold_exists d)
  change ∀ n (H : SimpleGraph (Fin n)), (∀ v, (H.neighborSet v).ncard ≤ d) →
    Erdos934.h 3 d ≤ H.edgeSet.ncard → Erdos934.HasFarEdges H 3 at hh
  have hn := KMPProduct.noFar (KMPProduct.comap_common h f)
  exact le_of_lt (lt_of_not_ge (fun he => hn (hh _ H hD (hE.symm ▸ he))))

end KMPThreshold

namespace KMPPolarity

abbrev X (F : Type*) := (F × F) ⊕ (F ⊕ Unit)

private abbrev Triple (F : Type*) := F × F × F

variable {F : Type*} [Field F]

private def repr : X F → Triple F
  | .inl (a, b) => (1, a, b)
  | .inr (.inl t) => (0, 1, t)
  | .inr (.inr ()) => (0, 0, 1)

private def dot (a b : Triple F) : F :=
  a.1 * b.1 + a.2.1 * b.2.1 + a.2.2 * b.2.2

def R (a b : X F) : Prop := dot (repr a) (repr b) = 0

instance [DecidableEq F] : DecidableRel (R (F := F)) :=
  fun _ _ => inferInstanceAs (Decidable (_ = _))

theorem symm {a b : X F} (h : R a b) : R b a := by
  unfold R dot at *
  simpa only [mul_comm] using h

private lemma repr_ne_zero (a : X F) : repr a ≠ 0 := by
  rintro he
  rcases a with ⟨x,y⟩ | t
  · exact one_ne_zero (congrArg Prod.fst he)
  · rcases t with t | ⟨⟩
    · exact one_ne_zero (congrArg (fun p : Triple F => p.2.1) he)
    · exact one_ne_zero (congrArg (fun p : Triple F => p.2.2) he)

private lemma normalize (v : Triple F) (hv : v ≠ 0) :
    ∃ c : X F, ∃ k : F, k ≠ 0 ∧ v = k • repr c := by
  obtain ⟨x,y,z⟩ := v
  by_cases hx : x = 0
  · subst x
    by_cases hy : y = 0
    · subst y
      have hz : z ≠ 0 := by
        intro hz
        apply hv
        subst z
        rfl
      refine ⟨.inr (.inr ()),z,hz,?_⟩
      simp [repr, Prod.smul_mk, smul_eq_mul]
    · refine ⟨.inr (.inl (z / y)),y,hy,?_⟩
      have hz : y * (z / y) = z := by field_simp
      simp [repr, Prod.smul_mk, smul_eq_mul, hz]
  · refine ⟨.inl (y / x,z / x),x,hx,?_⟩
    have hy : x * (y / x) = y := by field_simp
    have hz : x * (z / x) = z := by field_simp
    simp [repr, Prod.smul_mk, smul_eq_mul, hy, hz]

private def dotLinear (a : Triple F) : Triple F →ₗ[F] F where
  toFun := dot a
  map_add' := by
    intro b c
    simp [dot]
    ring
  map_smul' := by
    intro k b
    simp [dot, smul_eq_mul]
    ring

theorem common (a b : X F) : ∃ c, R a c ∧ R b c := by
  let M := (dotLinear (repr a)).prod (dotLinear (repr b))
  have hsrc : Module.finrank F (Triple F) = 3 := by simp [Triple, Module.finrank_prod]
  have htrg : Module.finrank F (F × F) = 2 := by simp [Module.finrank_prod]
  have hdim := M.finrank_range_add_finrank_ker
  have hr := Submodule.finrank_le M.range
  rw [hsrc] at hdim
  rw [htrg] at hr
  have hker : 0 < Module.finrank F M.ker := by omega
  obtain ⟨v, hv⟩ := Module.finrank_pos_iff_exists_ne_zero.1 hker
  have hv' : (v : Triple F) ≠ 0 := fun h => hv (Subtype.ext h)
  obtain ⟨c,k,hk,hvc⟩ := normalize v.val hv'
  have hz := LinearMap.mem_ker.1 v.property
  rw [hvc, M.map_smul] at hz
  have h1 : k * dot (repr a) (repr c) = 0 := congrArg Prod.fst hz
  have h2 : k * dot (repr b) (repr c) = 0 := congrArg Prod.snd hz
  exact ⟨c, (mul_eq_zero.1 h1).resolve_left hk, (mul_eq_zero.1 h2).resolve_left hk⟩

omit [Field F] in
theorem point_card (F : Type*) [Fintype F] :
    Fintype.card (X F) = Fintype.card F ^ 2 + Fintype.card F + 1 := by
  simp [X, Fintype.card_sum, Fintype.card_prod, pow_two, add_assoc]

theorem galoisField_card (p n : ℕ) [Fact p.Prime] (hn : n ≠ 0) :
    letI := Fintype.ofFinite (GaloisField p n)
    Fintype.card (GaloisField p n) = p ^ n := by
  exact (@Nat.card_eq_fintype_card (GaloisField p n) (Fintype.ofFinite _)).symm.trans
    (GaloisField.card p n hn)


private lemma solve_linear {x a t : F} (ha : a ≠ 0) : x + a * t = 0 ↔ t = -x / a := by
  rw [eq_div_iff ha]
  constructor <;> intro h <;> linear_combination h

private lemma row_card_of_bijection [Fintype F] [DecidableEq F] {a : X F}
    (f : Option F → X F) (hR : ∀ i, R a (f i)) (hi : Function.Injective f)
    (hs : ∀ b, R a b → ∃ i, f i = b) :
    (Finset.univ.filter (R a)).card = Fintype.card F + 1 := by
  calc
    _ = (Finset.univ : Finset (Option F)).card := by
      symm
      apply Finset.card_bij (fun i _ => f i)
      · intro i _
        exact Finset.mem_filter.2 ⟨Finset.mem_univ _,hR i⟩
      · intro i _ j _ hij
        exact hi hij
      · intro b hb
        obtain ⟨i,hi⟩ := hs b (Finset.mem_filter.1 hb).2
        exact ⟨i,Finset.mem_univ _,hi⟩
    _ = _ := by simp

theorem row_card [Fintype F] [DecidableEq F] (a : X F) :
    (Finset.univ.filter (R a)).card = Fintype.card F + 1 := by
  obtain ⟨x,y,z,hxyz⟩ : ∃ x y z : F, repr a = (x,y,z) :=
    ⟨(repr a).1,(repr a).2.1,(repr a).2.2,rfl⟩
  have hAffine (u v : F) : R a (.inl (u,v)) ↔ x + y * u + z * v = 0 := by
    rw [R,hxyz]
    simp [repr,dot]
  have hInfinity (u : F) : R a (.inr (.inl u)) ↔ y + z * u = 0 := by
    rw [R,hxyz]
    simp [repr,dot]
  have hLast : R a (.inr (.inr ())) ↔ z = 0 := by
    rw [R,hxyz]
    simp [repr,dot]
  by_cases hz : z = 0
  · by_cases hy : y = 0
    · have hx : x ≠ 0 := by
        intro hx
        apply repr_ne_zero a
        simp [hxyz,hx,hy,hz]
      let f : Option F → X F
        | none => .inr (.inr ())
        | some t => .inr (.inl t)
      apply row_card_of_bijection f
      · rintro (_ | t)
        · simp [f,hLast,hz]
        · simp [f,hInfinity,hy,hz]
      · rintro (_ | u) (_ | v) he <;> simp_all [f]
      · rintro (⟨u,v⟩ | (t | ⟨⟩)) hb
        · exact (hx (by simpa [hAffine,hy,hz] using hb)).elim
        · exact ⟨some t,rfl⟩
        · exact ⟨none,rfl⟩
    · let f : Option F → X F
        | none => .inr (.inr ())
        | some t => .inl (-x / y,t)
      apply row_card_of_bijection f
      · rintro (_ | t)
        · simp [f,hLast,hz]
        · simp only [f,hAffine,hz,zero_mul,add_zero]
          exact (solve_linear hy).2 rfl
      · rintro (_ | u) (_ | v) he <;> simp_all [f]
      · rintro (⟨u,v⟩ | (t | ⟨⟩)) hb
        · have hu : u = -x / y := (solve_linear hy).1 (by simpa [hAffine,hz] using hb)
          exact ⟨some v,by simp [f,hu]⟩
        · exact (hy (by simpa [hInfinity,hz] using hb)).elim
        · exact ⟨none,rfl⟩
  · let f : Option F → X F
      | none => .inr (.inl (-y / z))
      | some t => .inl (t,-(x + y * t) / z)
    apply row_card_of_bijection f
    · rintro (_ | t)
      · exact (hInfinity _).2 ((solve_linear hz).2 rfl)
      · exact (hAffine _ _).2 ((solve_linear hz).2 rfl)
    · rintro (_ | u) (_ | v) he <;> simp_all [f]
    · rintro (⟨u,v⟩ | (t | ⟨⟩)) hb
      · have hv : v = -(x + y * u) / z := (solve_linear hz).1 ((hAffine _ _).1 hb)
        exact ⟨some u,by simp [f,hv]⟩
      · have ht : t = -y / z := (solve_linear hz).1 ((hInfinity _).1 hb)
        exact ⟨none,by simp [f,ht]⟩
      · exact (hz (hLast.1 hb)).elim
end KMPPolarity

open Filter

namespace KMPDense

private theorem irrational_log_two_div_log_three :
    Irrational (Real.log 2 / Real.log 3) := by
  rw [irrational_iff_ne_rational]
  intro a b hb h
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have h3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hbR : (b : ℝ) ≠ 0 := Int.cast_ne_zero.mpr hb
  have hcross : Real.log 2 * (b : ℝ) = (a : ℝ) * Real.log 3 :=
    (div_eq_div_iff h3.ne' hbR).mp h
  have habs := congrArg abs hcross
  rw [abs_mul, abs_mul, abs_of_pos h2, abs_of_pos h3, ← Int.cast_abs, ← Int.cast_abs,
    ← Int.natCast_natAbs, ← Int.natCast_natAbs, Int.cast_natCast, Int.cast_natCast,
    mul_comm (Real.log 2), ← Real.log_pow, ← Real.log_pow] at habs
  have hpow : (2 : ℝ) ^ b.natAbs = (3 : ℝ) ^ a.natAbs :=
    Real.log_injOn_pos (x₁ := (2 : ℝ) ^ b.natAbs) (x₂ := (3 : ℝ) ^ a.natAbs)
      (show 0 < (2 : ℝ) ^ b.natAbs by positivity)
      (show 0 < (3 : ℝ) ^ a.natAbs by positivity) habs
  have hpowN : (2 : ℕ) ^ b.natAbs = 3 ^ a.natAbs := by exact_mod_cast hpow
  have hd : 2 ∣ (2 : ℕ) ^ b.natAbs :=
    dvd_pow_self 2 (Int.natAbs_ne_zero.mpr hb)
  rw [hpowN] at hd
  exact (by decide : ¬ (2 : ℕ) ∣ 3) (Nat.prime_two.dvd_of_dvd_pow hd)

private theorem small_combination {u v δ : ℝ} (hirr : Irrational (u / v)) (hδ : 0 < δ) :
    ∃ m n : ℤ, 0 < (m : ℝ) * u + (n : ℝ) * v ∧ (m : ℝ) * u + (n : ℝ) * v < δ := by
  have hd : Dense (AddSubgroup.closure {u, v} : Set ℝ) :=
    dense_addSubgroupClosure_pair_iff.mpr hirr
  obtain ⟨t, ht, ht0, htδ⟩ := hd.exists_between hδ
  change t ∈ AddSubgroup.closure {u, v} at ht
  rw [← Set.singleton_union, AddSubgroup.closure_union, ← AddSubgroup.zmultiples_eq_closure,
    ← AddSubgroup.zmultiples_eq_closure] at ht
  obtain ⟨s, hs, w, hw, rfl⟩ := AddSubgroup.mem_sup.mp ht
  obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hs
  obtain ⟨n, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hw
  exact ⟨m, n, by simpa only [zsmul_eq_mul] using ht0, by simpa only [zsmul_eq_mul] using htδ⟩

private theorem eventually_log_combination {u v δ : ℝ} (hv : 0 < v)
    (hirr : Irrational (u / v)) (hδ : 0 < δ) (M : ℕ) :
    ∀ᶠ x : ℝ in atTop, ∃ a b : ℕ, M ≤ a ∧ M ≤ b ∧
      (a : ℝ) * u + (b : ℝ) * v ≤ x ∧ x - δ ≤ (a : ℝ) * u + (b : ℝ) * v := by
  obtain ⟨m, n, ht0, htδ⟩ := small_combination hirr hδ
  let t := (m : ℝ) * u + (n : ℝ) * v
  let K : ℤ := ⌊v / t⌋
  let A : ℤ := (M : ℤ) + K * |m|
  let B : ℤ := (M : ℤ) + K * |n|
  filter_upwards [eventually_ge_atTop ((A : ℝ) * u + (B : ℝ) * v)] with x hx
  let q : ℤ := ⌊(x - (A : ℝ) * u) / v⌋
  have hqB : B ≤ q := Int.le_floor.mpr ((le_div_iff₀ hv).mpr (by linarith))
  have hqle : (q : ℝ) * v ≤ x - (A : ℝ) * u :=
    (le_div_iff₀ hv).mp (Int.floor_le _)
  have hqlt : x - (A : ℝ) * u < ((q : ℝ) + 1) * v :=
    (div_lt_iff₀ hv).mp (Int.lt_floor_add_one _)
  let y := x - ((A : ℝ) * u + (q : ℝ) * v)
  have hy0 : 0 ≤ y := by dsimp only [y]; linarith
  have hyv : y < v := by dsimp only [y]; linarith
  let j : ℤ := ⌊y / t⌋
  have hj0 : 0 ≤ j := Int.floor_nonneg.mpr (div_nonneg hy0 ht0.le)
  have hjK : j ≤ K := Int.floor_mono (div_le_div_of_nonneg_right hyv.le ht0.le)
  have hjle : (j : ℝ) * t ≤ y :=
    (le_div_iff₀ ht0).mp (Int.floor_le _)
  have hjlt : y < ((j : ℝ) + 1) * t :=
    (div_lt_iff₀ ht0).mp (Int.lt_floor_add_one _)
  have hshift (z : ℤ) : 0 ≤ K * |z| + j * z := by
    calc
      0 = j * |z| + j * (-|z|) := by ring
      _ ≤ K * |z| + j * z := add_le_add
        (mul_le_mul_of_nonneg_right hjK (abs_nonneg z))
        (mul_le_mul_of_nonneg_left (neg_abs_le z) hj0)
  have haM : (M : ℤ) ≤ A + j * m := by
    dsimp only [A]
    have := hshift m
    omega
  have hbM : (M : ℤ) ≤ q + j * n := by
    dsimp only [B] at hqB
    have := hshift n
    omega
  have ha0 : 0 ≤ A + j * m := by omega
  have hb0 : 0 ≤ q + j * n := by omega
  let a := (A + j * m).toNat
  let b := (q + j * n).toNat
  have ha : (a : ℤ) = A + j * m := Int.toNat_of_nonneg ha0
  have hb : (b : ℤ) = q + j * n := Int.toNat_of_nonneg hb0
  have haR : (a : ℝ) = (A : ℝ) + (j : ℝ) * (m : ℝ) := by exact_mod_cast ha
  have hbR : (b : ℝ) = (q : ℝ) + (j : ℝ) * (n : ℝ) := by exact_mod_cast hb
  have he : (a : ℝ) * u + (b : ℝ) * v = (A : ℝ) * u + (q : ℝ) * v + (j : ℝ) * t := by
    rw [haR, hbR]
    dsimp only [t]
    ring
  refine ⟨a, b, by omega, by omega, ?_, ?_⟩
  · rw [he]
    dsimp only [y] at hjle
    linarith
  · rw [he]
    dsimp only [y] at hjlt
    change t < δ at htδ
    linarith only [hjlt, htδ]

private lemma log_pow_add_one_bounds {p : ℕ} (hp : 1 < p) (a : ℕ) :
    (a : ℝ) * Real.log (p : ℝ) ≤ Real.log ((p : ℝ) ^ a + 1) ∧
      Real.log ((p : ℝ) ^ a + 1) ≤ (a : ℝ) * Real.log (p : ℝ) + 1 / (p : ℝ) ^ a := by
  have hp0 : 0 < (p : ℝ) := by exact_mod_cast (by omega : 0 < p)
  have hpow : 0 < (p : ℝ) ^ a := pow_pos hp0 a
  constructor
  · rw [← Real.log_pow]
    exact Real.log_le_log hpow (by linarith)
  · have h1 : 0 < 1 + 1 / (p : ℝ) ^ a := by positivity
    have he : (p : ℝ) ^ a + 1 = (p : ℝ) ^ a * (1 + 1 / (p : ℝ) ^ a) := by
      field_simp
    rw [he, Real.log_mul hpow.ne' h1.ne', Real.log_pow]
    linarith [Real.log_le_sub_one_of_pos h1]

/-- Degrees of the form used in the Kumar–Mohar–Pragada construction approximate
all sufficiently large degrees from below, with both exponents arbitrarily large. -/
theorem eventually_degree_approximation {η : ℝ} (hη : 0 < η) (hη1 : η < 1) (M : ℕ) :
    ∀ᶠ d : ℕ in atTop, ∃ a b : ℕ, M ≤ a ∧ M ≤ b ∧
      15 * ((2 ^ a + 1) * (3 ^ b + 1)) ≤ d ∧
      (1 - η) * (d : ℝ) ≤ ((15 * ((2 ^ a + 1) * (3 ^ b + 1)) : ℕ) : ℝ) := by
  let δ := -Real.log (1 - η) / 2
  have hc : 0 < 1 - η := by linarith
  have hδ : 0 < δ := by
    dsimp only [δ]
    linarith [Real.log_neg hc (by linarith : 1 - η < 1)]
  obtain ⟨L, hL⟩ := exists_nat_ge (2 / δ)
  let N := max M L
  have hinv {p a : ℕ} (hp : 1 < p) (ha : N ≤ a) : 1 / (p : ℝ) ^ a ≤ δ / 2 := by
    have hpos : 0 < (p : ℝ) ^ a := pow_pos (by exact_mod_cast (by omega : 0 < p)) _
    have h1 : (L : ℝ) ≤ (a : ℝ) := by exact_mod_cast (le_trans (le_max_right M L) ha)
    have h2 : (a : ℝ) ≤ (p : ℝ) ^ a := by exact_mod_cast (Nat.lt_pow_self (n := a) hp).le
    have h3 := (div_le_iff₀ hδ).mp (hL.trans (h1.trans h2))
    apply (div_le_iff₀ hpos).mpr
    nlinarith
  have hLog : Tendsto (fun d : ℕ => Real.log (d : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hX : Tendsto (fun d : ℕ => Real.log (d : ℝ) - Real.log 15 - δ) atTop atTop := by
    apply tendsto_atTop.mpr
    intro B
    filter_upwards [hLog.eventually_ge_atTop (B + Real.log 15 + δ)] with d hd
    linarith
  have hApprox := hX.eventually (eventually_log_combination
    (Real.log_pos (by norm_num : (1 : ℝ) < 3)) irrational_log_two_div_log_three hδ N)
  filter_upwards [hApprox, eventually_gt_atTop (0 : ℕ)] with d hA hd
  obtain ⟨a, b, ha, hb, hlow, hhigh⟩ := hA
  let U : ℝ := (2 : ℝ) ^ a + 1
  let V : ℝ := (3 : ℝ) ^ b + 1
  have hU : 0 < U := by dsimp only [U]; positivity
  have hV : 0 < V := by dsimp only [V]; positivity
  have hdR : 0 < (d : ℝ) := by exact_mod_cast hd
  have hlow₂ : (a : ℝ) * Real.log 2 ≤ Real.log U :=
    (log_pow_add_one_bounds (p := 2) (by decide) a).1
  have hlow₃ : (b : ℝ) * Real.log 3 ≤ Real.log V :=
    (log_pow_add_one_bounds (p := 3) (by decide) b).1
  have hu₂ : Real.log U ≤ (a : ℝ) * Real.log 2 + δ / 2 :=
    (log_pow_add_one_bounds (p := 2) (by decide) a).2.trans
      (add_le_add (le_refl _) (hinv (p := 2) (by decide) ha))
  have hu₃ : Real.log V ≤ (b : ℝ) * Real.log 3 + δ / 2 :=
    (log_pow_add_one_bounds (p := 3) (by decide) b).2.trans
      (add_le_add (le_refl _) (hinv (p := 3) (by decide) hb))
  have hW : 0 < 15 * (U * V) := by positivity
  have hLogW : Real.log (15 * (U * V)) = Real.log 15 + Real.log U + Real.log V := by
    rw [Real.log_mul (by norm_num) (mul_ne_zero hU.ne' hV.ne'), Real.log_mul hU.ne' hV.ne']
    ring
  have hdLow : 15 * (U * V) ≤ (d : ℝ) := by
    apply (Real.log_le_log_iff hW hdR).mp
    rw [hLogW]
    linarith
  have hdHigh : (1 - η) * (d : ℝ) ≤ 15 * (U * V) := by
    apply (Real.log_le_log_iff (mul_pos hc hdR) hW).mp
    rw [Real.log_mul hc.ne' hdR.ne', hLogW]
    dsimp only [δ] at hhigh
    linarith
  refine ⟨a, b, (le_max_left M L).trans ha, (le_max_left M L).trans hb, ?_, ?_⟩
  · dsimp only [U, V] at hdLow
    exact_mod_cast hdLow
  · dsimp only [U, V] at hdHigh
    exact_mod_cast hdHigh

end KMPDense

namespace KMPEstimate

private lemma factor_lower {η : ℝ} {q : ℕ} (hq : 2 ≤ η * ((q : ℝ) + 1)) :
    (1 - η / 2) * ((q : ℝ) + 1) ^ 2 ≤ (q : ℝ) ^ 2 + q + 1 := by
  have hq' : 0 ≤ (q : ℝ) := Nat.cast_nonneg _
  have hb : (q : ℝ) + 1 ≤ (η * ((q : ℝ) + 1)) * ((q : ℝ) + 1) / 2 := by
    have hc := mul_le_mul_of_nonneg_right hq (show 0 ≤ (q : ℝ) + 1 by positivity)
    linarith
  nlinarith only [hb, hq']

lemma card_lower {η : ℝ} (hη₁ : η ≤ 1) {p q : ℕ}
    (hp : 2 ≤ η * ((p : ℝ) + 1)) (hq : 2 ≤ η * ((q : ℝ) + 1)) :
    (1 - η) * (((p : ℝ) + 1) * ((q : ℝ) + 1)) ^ 2 ≤
      ((p : ℝ) ^ 2 + p + 1) * ((q : ℝ) ^ 2 + q + 1) := by
  have hn : 0 ≤ 1 - η / 2 := by linarith
  calc
    _ ≤ (1 - η / 2) ^ 2 * (((p : ℝ) + 1) * ((q : ℝ) + 1)) ^ 2 :=
      mul_le_mul_of_nonneg_right (by nlinarith [sq_nonneg η]) (sq_nonneg _)
    _ = ((1 - η / 2) * ((p : ℝ) + 1) ^ 2) *
        ((1 - η / 2) * ((q : ℝ) + 1) ^ 2) := by ring
    _ ≤ _ := mul_le_mul (factor_lower hp) (factor_lower hq)
      (mul_nonneg hn (sq_nonneg _)) (by positivity)

lemma lower_bound {ε η : ℝ} (hη₀ : 0 ≤ η) (hη₁ : η ≤ 1) (hε : 8 * η ≤ ε)
    {D k N E : ℝ} (hD : 0 ≤ D) (hk : 0 ≤ k)
    (hd : (1 - η) * D ≤ 15 * k) (hN : (1 - η) * k ^ 2 ≤ N)
    (hE : E = 3795 * k * N) :
    (253 / 225 - ε) * D ^ 3 ≤ E := by
  have h1 : 0 ≤ 1 - η := sub_nonneg.mpr hη₁
  have hBern : 1 - 4 * η ≤ (1 - η) ^ 4 := by
    have h := mul_nonneg (sq_nonneg η) (show 0 ≤ (η - 2) ^ 2 + 2 by positivity)
    nlinarith only [h]
  have hc : 253 / 225 - ε ≤ (253 / 225 : ℝ) * ((1 - η) ^ 4) := by
    calc
      _ ≤ (253 / 225 : ℝ) * (1 - 4 * η) := by linarith
      _ ≤ _ := mul_le_mul_of_nonneg_left hBern (by norm_num)
  have hd' : (1 - η) * D / 15 ≤ k := by linarith
  have hpow := pow_le_pow_left₀ (div_nonneg (mul_nonneg h1 hD) (by norm_num : (0 : ℝ) ≤ 15)) hd' 3
  calc
    _ ≤ ((253 / 225 : ℝ) * (1 - η) ^ 4) * D ^ 3 :=
      mul_le_mul_of_nonneg_right hc (pow_nonneg hD _)
    _ = 3795 * (1 - η) * ((1 - η) * D / 15) ^ 3 := by ring
    _ ≤ 3795 * (1 - η) * k ^ 3 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg (by norm_num) h1)
    _ = (3795 * k) * ((1 - η) * k ^ 2) := by ring
    _ ≤ 3795 * k * N := mul_le_mul_of_nonneg_left hN (mul_nonneg (by norm_num) hk)
    _ = E := hE.symm

end KMPEstimate

namespace KMPEstimate

lemma bound_of_powers (B : SimpleGraph (Fin 506)) [DecidableRel B.Adj]
    (hbase : ∀ v, B.degree v = 15) (hcommon : KMPProduct.CommonEndpoints B)
    {ε η : ℝ} (hη : 0 < η) (hη₁ : η < 1) (hε : 8 * η ≤ ε)
    {M a b d : ℕ} (hM : 1 ≤ M) (hMη : 2 ≤ η * (M : ℝ))
    (ha : M ≤ a) (hb : M ≤ b)
    (hdeg : 15 * ((2 ^ a + 1) * (3 ^ b + 1)) ≤ d)
    (hnear : (1 - η) * (d : ℝ) ≤ ((15 * ((2 ^ a + 1) * (3 ^ b + 1)) : ℕ) : ℝ)) :
    (253 / 225 - ε) * (d : ℝ) ^ 3 ≤ (Erdos934.h 3 d : ℝ) := by
  classical
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let _ : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let F := GaloisField 2 a
  let L := GaloisField 3 b
  let _ : Fintype F := Fintype.ofFinite F
  let _ : Fintype L := Fintype.ofFinite L
  let p : ℕ := 2 ^ a
  let q : ℕ := 3 ^ b
  let k := (p + 1) * (q + 1)
  let N := (p ^ 2 + p + 1) * (q ^ 2 + q + 1)
  have hp : Fintype.card F = p := KMPPolarity.galoisField_card 2 a (by omega)
  have hq : Fintype.card L = q := KMPPolarity.galoisField_card 3 b (by omega)
  let R : KMPPolarity.X F → KMPPolarity.X F → Prop := KMPPolarity.R
  let T : KMPPolarity.X L → KMPPolarity.X L → Prop := KMPPolarity.R
  let A := KMPProduct.prodRel R T
  have hs : ∀ ⦃u v⦄, A u v → A v u :=
    KMPProduct.prod_symm (R := R) (T := T) (fun _ _ h => KMPPolarity.symm h) (fun _ _ h => KMPPolarity.symm h)
  let H := KMPProduct.lift B A hs
  have hOrder : Fintype.card (KMPPolarity.X F × KMPPolarity.X L) = N := by
    rw [Fintype.card_prod, KMPPolarity.point_card, KMPPolarity.point_card, hp, hq]
  have hRow (v : KMPPolarity.X F × KMPPolarity.X L) :
      (Finset.univ.filter (A v)).card = k := by
    change (Finset.univ.filter (KMPProduct.prodRel R T v)).card = k
    rw [KMPProduct.prod_card]
    change (Finset.univ.filter (KMPPolarity.R v.1)).card *
      (Finset.univ.filter (KMPPolarity.R v.2)).card = k
    rw [KMPPolarity.row_card, KMPPolarity.row_card, hp, hq]
  have hReg (v : Fin 506 × (KMPPolarity.X F × KMPPolarity.X L)) :
      H.degree v = 15 * k := by
    rw [KMPProduct.lift_degree, hbase, hRow]
  have hConn : KMPProduct.CommonEndpoints H :=
    KMPProduct.lift_common hs hcommon <|
      KMPProduct.prod_common KMPPolarity.common KMPPolarity.common
  have hEdge : H.edgeFinset.card = 3795 * k * N := by
    have hh := KMPProduct.edge_count H hReg
    rw [Fintype.card_prod, Fintype.card_fin, hOrder] at hh
    have hmul : 506 * N * (15 * k) = 2 * (3795 * k * N) := by ring
    omega
  have hHd : H.edgeFinset.card ≤ Erdos934.h 3 d :=
    KMPThreshold.le_h H (fun v => (hReg v).trans_le hdeg) hConn
  have hpM : M ≤ p := ha.trans (Nat.lt_pow_self (by decide : 1 < 2)).le
  have hqM : M ≤ q := hb.trans (Nat.lt_pow_self (by decide : 1 < 3)).le
  have hRp : 2 ≤ η * ((p : ℝ) + 1) := hMη.trans (mul_le_mul_of_nonneg_left
    (le_add_of_nonneg_right (by norm_num) |>.trans' (by exact_mod_cast hpM)) hη.le)
  have hRq : 2 ≤ η * ((q : ℝ) + 1) := hMη.trans (mul_le_mul_of_nonneg_left
    (le_add_of_nonneg_right (by norm_num) |>.trans' (by exact_mod_cast hqM)) hη.le)
  have hN : (1 - η) * (k : ℝ) ^ 2 ≤ (N : ℝ) := by
    push_cast [k, N]
    exact card_lower hη₁.le hRp hRq
  have hdR : (1 - η) * (d : ℝ) ≤ 15 * (k : ℝ) := by
    have hh : (1 - η) * (d : ℝ) ≤ ((15 * k : ℕ) : ℝ) := hnear
    simpa only [Nat.cast_mul, Nat.cast_ofNat] using hh
  have hEdgeR : (H.edgeFinset.card : ℝ) = 3795 * (k : ℝ) * (N : ℝ) := by exact_mod_cast hEdge
  exact (lower_bound hη.le hη₁.le hε (Nat.cast_nonneg d) (Nat.cast_nonneg k) hdR hN hEdgeR).trans
    (by exact_mod_cast hHd)

end KMPEstimate

open Filter in
theorem kmpAsymptotic (B : SimpleGraph (Fin 506)) [DecidableRel B.Adj]
    (hbase : ∀ v, B.degree v = 15) (hcommon : KMPProduct.CommonEndpoints B) :
    type_of% @Erdos934.erdos_934.variants.kmp_liminf := by
  intro ε hε
  let η := min (1 / 2 : ℝ) (ε / 8)
  have hη : 0 < η := lt_min (by norm_num) (by positivity)
  have hη₁ : η < 1 := (min_le_left _ _).trans_lt (by norm_num)
  have hηε : 8 * η ≤ ε := by
    have hh : η ≤ ε / 8 := min_le_right _ _
    linarith
  obtain ⟨M, hM⟩ := exists_nat_ge (max 1 (2 / η))
  have hM₁ : 1 ≤ M := by
    exact_mod_cast (le_max_left (1 : ℝ) (2 / η)).trans hM
  have hMη : 2 ≤ η * (M : ℝ) := by
    rw [mul_comm]
    exact (div_le_iff₀ hη).mp ((le_max_right _ _).trans hM)
  filter_upwards [KMPDense.eventually_degree_approximation hη hη₁ M] with d hd
  obtain ⟨a, b, ha, hb, hdeg, hnear⟩ := hd
  exact KMPEstimate.bound_of_powers B hbase hcommon hη hη₁ hηε hM₁ hMη ha hb hdeg hnear

theorem OMA.solution : type_of% @Erdos934.erdos_934.variants.kmp_liminf :=
  kmpAsymptotic KMPBase.graph KMPBase.degree KMPBase.common